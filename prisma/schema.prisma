generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum PaymentMethod {
  CASH
  CARD
  QR_CODE
  BANKING
}

enum OrderLifecycleState {
  DRAFT
  PAYING
  PARTIAL
  UNPAID
  PAID
  DELETED
}

enum OrderLogAction {
  CREATE_ORDER
  UPDATE_ORDER
  PRINT_ORDER
  DELETE_ORDER
  PAY_PARTIAL
  PAY_FULL
}

enum OrderAdjustmentMode {
  amount
  percent
}

enum ProductType {
  SINGLE
  COMBO
  TIME
}

enum PricingTypeSnapshot {
  FIXED
  TIME
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  email     String?  @unique
  fullName String?
  role     UserRole @default(STAFF)
  branchId  String?
  isActive Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  branch   Branch?  @relation(fields: [branchId], references: [id])
  orders   Order[]
  orderLogs OrderLog[]

  @@index([branchId])
  @@map("users")
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users    User[]
  tables   Table[]
  orders   Order[]
  productBranches ProductBranch[]

  @@map("branches")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  parent   Category?  @relation("CategoryRelation", fields: [parentId], references: [id])
  children Category[] @relation("CategoryRelation")
  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  sku         String?  @unique
  barcode     String?
  type        ProductType @default(SINGLE)
  autoPrice   Boolean     @default(false)
  price       Decimal  @db.Decimal(12, 2)
  costPrice   Decimal? @db.Decimal(12, 2)
  unit        String?
  weight      Decimal? @db.Decimal(12, 3)
  stock       Decimal  @default(0) @db.Decimal(12, 3)
  imageUrl    String?
  imageThumb  String?
  timeRateAmount Decimal? @db.Decimal(14, 2)
  timeRateMinutes Int?
  description String?
  isActive    Boolean  @default(true)
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?

  orderItems OrderItem[]
  productBranches ProductBranch[]

  @@index([categoryId])
  @@map("products")
}

model ProductBranch {
  id        String   @id @default(uuid())
  productId String
  branchId  String
  isActive  Boolean  @default(true)
  stock     Decimal  @default(0) @db.Decimal(12, 3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@map("product_branches")
}

model Table {
  id        String     @id @default(uuid())
  name      String
  capacity  Int        @default(4)
  status    TableStatus @default(AVAILABLE)
  branchId  String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  branch  Branch? @relation(fields: [branchId], references: [id])
  orders  Order[]

  @@index([branchId])
  @@map("tables")
}

model Order {
  id              String        @id @default(uuid())
  orderCode       String        @unique
  tableId         String?
  roomId          String?
  branchId        String?
  userId          String
  totalAmount     Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  discountMode    OrderAdjustmentMode @default(amount)
  discountValue   Decimal       @default(0) @db.Decimal(12, 4)
  surchargeAmount Decimal       @default(0) @db.Decimal(14, 2)
  surchargeMode   OrderAdjustmentMode @default(amount)
  surchargeValue  Decimal       @default(0) @db.Decimal(12, 4)
  finalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(14, 2)
  isDebtMarked   Boolean       @default(false)
  customerName    String?
  orderState      OrderLifecycleState @default(PARTIAL)
  paymentMethod  PaymentMethod?
  note           String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  leftAt         DateTime?     @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  table Table?  @relation(fields: [tableId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])
  user  User   @relation(fields: [userId], references: [id])
  items OrderItem[]
  logs  OrderLog[]

  @@index([branchId, orderState])
  @@index([branchId, createdAt])
  @@index([tableId])
  @@index([roomId])
  @@index([userId])
  @@map("orders")
}

model OrderLog {
  id        String         @id @default(uuid())
  orderId   String
  action    OrderLogAction
  detail    String?
  snapshot  Json?
  createdBy String?
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_logs")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  pricingTypeSnapshot PricingTypeSnapshot @default(FIXED)
  baseUnitPrice Decimal? @db.Decimal(14, 2)
  unitPrice  Decimal  @db.Decimal(12, 2)
  lineDiscountAmount Decimal @default(0) @db.Decimal(12, 2)
  lineSurchargeAmount Decimal @default(0) @db.Decimal(12, 2)
  totalPrice Decimal  @db.Decimal(12, 2)
  timeRateAmountSnapshot Decimal? @db.Decimal(14, 2)
  timeRateMinutesSnapshot Int?
  usedMinutes Int @default(0)
  startAt   DateTime? @db.Timestamptz(3)
  stopAt    DateTime? @db.Timestamptz(3)
  displayOrder Int @default(0)
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId, displayOrder])
  @@index([productId])
  @@map("order_items")
}

model Printer {
  id        String   @id @default(uuid())
  name      String
  ipAddress String
  port      Int      @default(9100)
  paperSize String?  @default("80mm")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("printers")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("settings")
}
